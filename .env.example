# make prepare allocates the lowest free port and writes it to .env.
DEV_PORT_START=8080
DEV_MODE=demo
# Hub mode automatically keeps its key in .quotum-dev/hub-keys, outside hub-data.
# Optional explicit key file overrides it; resolved from this checkout.
QUOTUM_SECRET_KEY_FILE=
DEV_SET=all
DEV_STILL=false
# Empty uses the set's default reset scene.
DEV_RESETS=
SLOT_CPUS=4
# Optional Coder workspace publication. Concrete deployment values stay local.
DEV_ACCESS=none
PUBLIC_DOMAIN=
# With DEV_ACCESS=coder these may come from the Coder agent environment.
CODER_WORKSPACE_ID=
CODER_WORKSPACE_AGENT_NAME=
CODER_WORKSPACE_NAME=
CODER_WORKSPACE_OWNER_NAME=
