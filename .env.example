# Optional overrides for the local hub stand (`make dev app=hub`) or direct runs.
# Devkit publishes container port 8080 on an ephemeral 127.0.0.1 host port (`make status`).
QUOTUM_PORT=8080
QUOTUM_BIND=0.0.0.0
QUOTUM_ALLOWED_HOSTS=127.0.0.1,localhost,hub

# Optional explicit secret key file when running the standalone hub directly.
QUOTUM_SECRET_KEY_FILE=
