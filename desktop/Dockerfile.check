# Containerized Linux toolchain for `make prepare-desktop` and `make check-desktop`
# without requiring host Rust or GTK development packages.
# Base digests and PNPM_VERSION match `.devkit/runtime/{toolchains.env,rust.Dockerfile,pnpm.env}`.
FROM node:24.22.1-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS node
FROM rust:1.99.1-slim-bookworm@sha256:86234e857a413004348b471d11a4ebe1aa92d2eae2b6b143cac68fd1ac3c48be

ARG PNPM_VERSION=12.21.0

# Match the Debian snapshot pinned in `.devkit/runtime/desktop.Dockerfile`.
RUN printf '%s\n' \
    'Types: deb' \
    'URIs: http://snapshot.debian.org/archive/debian/20261020T213255Z/' \
    'Suites: bookworm bookworm-updates' \
    'Components: main' \
    'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
    'Check-Valid-Until: no' \
    '' \
    'Types: deb' \
    'URIs: http://snapshot.debian.org/archive/debian-security/20261020T213255Z/' \
    'Suites: bookworm-security' \
    'Components: main' \
    'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
    'Check-Valid-Until: no' \
    > /etc/apt/sources.list.d/debian.sources \
  && rustup component add --toolchain 1.99.1 clippy rustfmt \
  && apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    gcc \
    libc6-dev \
    libgtk-3-dev \
    libssl-dev \
    pkg-config \
    unzip \
    xz-utils \
  && rm -rf /var/lib/apt/lists/*

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
  && npm install -g "pnpm@${PNPM_VERSION}" --ignore-scripts --no-audit --no-fund \
  && set -- /usr/local/lib/node_modules/pnpm/node_modules/@pnpm/exe.*/pnpm \
  && test "$#" -eq 1 && test -x "$1" \
  && ln -sf "$1" /usr/local/bin/pnpm \
  && rm -rf /root/.npm

ENV RUSTUP_AUTO_INSTALL=0
