/* $1 P, $2 bench E, $3 UID, $4/$5 parent birth ticks, $6 USER_HZ=100.
 * $7/$8/$9 expected fixture device major/minor/inode, from its owned FD.
 * $10/$11 precreated gated fixture F PID/birth ticks; MAIN THREADS ONLY.
 * Exact classic entry only: an entry does not prove blocking, duration or absence.
 * Numeric entry snapshots only; counts are observed entries, never CPU or wait time.
 * class: 0 unknown, 1 file, 2 anon(tag1), 3 KSM(tag3). Never dereference tags.
 * ABI: v6.17 folio_wait_bit_common(folio,bit,state,behavior), DROP=2.
 * Snapshot precedes any DROP. No pointer, return probe or duration state is retained.
 * At most 64 numeric keys per cohort, four fixture and sixteen browser entry rows.
 */
BEGIN { if ($6 != 100) { @config_invalid = 1; exit(); } }

tracepoint:syscalls:sys_exit_setsid
/!@capture_closed && tid == pid && (uint64)args->ret == pid && uid == $3 && $6 == 100/
{
  $parent = (uint64)curtask->real_parent->tgid;
  $c = $parent == $2 ? 2 : 0;
  $ticks = (uint64)curtask->real_parent->start_boottime / 10000000;
  if ($c && $ticks == $5) {
    if (@root[$c]) { @extra_admission[$c] = @extra_admission[$c] + 1; }
    else {
      @root[$c] = pid; @birth[$c] = (uint64)curtask->start_boottime;
      @parent[$c] = $parent; @bound_ns[$c] = nsecs(monotonic); @alive[$c] = 1;
      @parent_ticks[$c] = $ticks;
      @cohort[pid] = $c;
      printf("QFW_BIND %llu %llu %llu %llu %llu %llu\n", $c, (uint64)pid, @birth[$c], $parent, (uint64)uid, @bound_ns[$c]);
    }
  }
}

kprobe:folio_wait_bit_common
/!@capture_closed && tid == pid && (@cohort[pid] || pid == $10)/
{
  $entered = nsecs(monotonic);
  if (pid == $10 && !@root[1] && uid == $3 && $6 == 100 && (uint64)curtask->start_boottime / 10000000 == $11 && (uint64)curtask->real_parent->tgid == $1 && (uint64)curtask->real_parent->start_boottime / 10000000 == $4) {
    @root[1] = pid; @birth[1] = (uint64)curtask->start_boottime;
    @parent[1] = $1; @parent_ticks[1] = $4; @bound_ns[1] = $entered;
    @alive[1] = 1; @cohort[pid] = 1;
    printf("QFW_BIND %llu %llu %llu %llu %llu %llu\n", (uint64)1, (uint64)pid, @birth[1], (uint64)$1, (uint64)uid, $entered);
  }
  $c = @cohort[pid];
  if ($c && @alive[$c] && @root[$c] == pid && @birth[$c] == (uint64)curtask->start_boottime && @parent[$c] == (uint64)curtask->real_parent->tgid && @parent_ticks[$c] == (uint64)curtask->real_parent->start_boottime / 10000000 && uid == $3) {
    @entries[$c] = @entries[$c] + 1;
    $f = (struct folio *)arg0; $raw = (uint64)$f->mapping;
    $kind = 0; $major = 0; $minor = 0; $ino = (uint64)0; $index = (uint64)0;
    if (($raw & 3) == 1) { $kind = 2; }
    else if (($raw & 3) == 3) { $kind = 3; }
    else if ($raw && !($raw & 3)) {
      $m = (struct address_space *)$raw; $inode = $m->host;
      if ($inode != 0) {
        $sb = $inode->i_sb; $back = $inode->i_mapping; $index0 = (uint64)$f->index;
        if ($sb != 0 && $back == $m) {
          $dev = (uint64)$sb->s_dev; $ino0 = (uint64)$inode->i_ino;
          if ((uint64)$f->mapping == $raw && $m->host == $inode && $inode->i_mapping == $m && (uint64)$f->index == $index0) {
            $kind = 1; $major = $dev >> 20; $minor = $dev & 1048575;
            $ino = $ino0; $index = $index0;
          }
        }
      }
    }
    if ((uint64)$f->mapping != $raw) { $kind = 0; $major = 0; $minor = 0; $ino = 0; $index = 0; }
    if ($kind != 1) { @mapping_unqualified[$c] = @mapping_unqualified[$c] + 1; }
    $key = ($c, $kind, $major, $minor, $ino, (int32)arg1, (int32)arg3);
    /* bpftrace 0.20 map keys list scalar fields, never a nested tuple key. */
    if (!@seen[$key.0, $key.1, $key.2, $key.3, $key.4, $key.5, $key.6] && @key_count[$c] >= 64) { @missing[$c] = @missing[$c] + 1; }
    else {
      if (!@seen[$key.0, $key.1, $key.2, $key.3, $key.4, $key.5, $key.6]) { @seen[$key.0, $key.1, $key.2, $key.3, $key.4, $key.5, $key.6] = 1; @key_count[$c] = @key_count[$c] + 1; }
      @count[$key.0, $key.1, $key.2, $key.3, $key.4, $key.5, $key.6] = count();
    }
    $eligible = $c == 2 || ($kind == 1 && $major == $7 && $minor == $8 && $ino == $9);
    if ($eligible && @entries_printed[$c] < (uint64)($c == 1 ? 4 : 16)) {
      @entries_printed[$c] = @entries_printed[$c] + 1;
      printf("QFW_ENTRY %llu %llu %llu %llu %llu %llu %llu %llu %lld %lld %llu\n", $c, (uint64)pid, @birth[$c], $kind, $major, $minor, $ino, $index, (int32)arg1, (int32)arg3, $entered);
    } else if ($eligible) { @entries_omitted[$c] = @entries_omitted[$c] + 1; }
  } else if ($c) { @identity_lost[$c] = @identity_lost[$c] + 1; }
}

tracepoint:sched:sched_process_exec
/!@capture_closed && tid == pid && @cohort[pid]/
{
  $c = @cohort[pid];
  if (@alive[$c] && @root[$c] == pid && @birth[$c] == (uint64)curtask->start_boottime && @parent[$c] == (uint64)curtask->real_parent->tgid && @parent_ticks[$c] == (uint64)curtask->real_parent->start_boottime / 10000000 && uid == $3) {
    @exec_ns[$c] = nsecs(monotonic); @exec_birth[$c] = (uint64)curtask->start_boottime;
    $mm = curtask->mm;
    if ($mm != 0 && $mm->exe_file != 0 && $mm->exe_file->f_inode != 0) { @exec_inode[$c] = (uint64)$mm->exe_file->f_inode->i_ino; }
    else { @exec_inode[$c] = 0; @exec_missing[$c] = @exec_missing[$c] + 1; }
    @exec_count[$c] = @exec_count[$c] + 1;
  }
}

tracepoint:signal:signal_generate
/!@capture_closed && args->sig == 15 && @cohort[(uint64)args->pid]/
{
  $c = @cohort[(uint64)args->pid];
  $at = nsecs(monotonic);
  if (@alive[$c] && @root[$c] == (uint64)args->pid && !@first_term_ns[$c]) {
    @first_term_ns[$c] = $at;
    @term_sender[$c] = ((uint64)pid, (uint64)curtask->group_leader->start_boottime, (uint64)uid, (int32)args->result);
    printf("QFW_TERM %llu %llu %llu %llu %llu %llu %llu %lld\n", $c, @root[$c], @birth[$c], @first_term_ns[$c], (uint64)pid, (uint64)curtask->group_leader->start_boottime, (uint64)uid, (int32)args->result);
  }
}

tracepoint:sched:sched_process_exit
/!@capture_closed && tid == pid && @cohort[pid]/
{
  $c = @cohort[pid];
  if (@root[$c] == pid && @birth[$c] == (uint64)curtask->start_boottime) {
    @alive[$c] = 0; @exit_ns[$c] = nsecs(monotonic);
    printf("QFW_EXIT %llu %llu %llu %llu\n", $c, (uint64)pid, @birth[$c], @exit_ns[$c]);
  }
}

interval:s:1 {
  if (!@capture_closed) {
    printf("QFW_TICK %llu\n", nsecs(monotonic));
    if (@root[2] && nsecs(monotonic) - @bound_ns[2] >= 21000000000) {
      @capture_closed = 1; @window_closed_ns = nsecs(monotonic);
      printf("QFW_WINDOW_CLOSED %llu\n", @window_closed_ns);
    }
  }
}
END { printf("QFW_END %llu\n", nsecs(monotonic)); } /* Automatic maps contain numeric keys/values only. */
