/* $1 P, $2 bench E, $3 UID, $4/$5 parent birth ticks, $6 USER_HZ=100.
 * $7/$8/$9 owned fixture device major/minor/inode; $10/$11 gated F PID/birth ticks.
 * MAIN THREADS ONLY. File context plus reported-D scheduler off-CPU intervals.
 * origin 1: get_pages success point/requested range; origin 2: filemap fault entry.
 * Indices are page units, inclusive; fault lastIndex equals firstIndex.
 * Filemap events do not prove disk I/O, physical blocking, duration or absence.
 * At most 64 numeric file/origin keys per cohort; no pointers are retained.
 * Print two eligible fixture/eight browser rows per origin; omitted counts explicit.
 */
BEGIN { if ($6 != 100) { @config_invalid = 1; exit(); } }

/* Exact CLONE_VM | CLONE_VFORK | SIGCHLD flags exclude earlier fixture reads.
 * Keep the literal uncast: bpftrace 0.20 tags syscall fields with user addrspace. */
tracepoint:syscalls:sys_enter_clone
/!@capture_closed && tid == pid && @cohort[pid] == 1 && uid == $3 && args->clone_flags == 16657/
{
  if (@alive[1] && @birth[1] == (uint64)curtask->start_boottime && @parent[1] == (uint64)curtask->real_parent->tgid && @parent_ticks[1] == (uint64)curtask->real_parent->start_boottime / 10000000) {
    @wait_armed = 1;
  } else { @identity_lost[1] = @identity_lost[1] + 1; }
}

/* Switch-in runs on the outgoing task: only switch-out may inspect curtask identity. */
tracepoint:sched:sched_switch
/!@capture_closed/
{
  /* Keep scalar field values across map calls, not addresses into the context. */
  $previous = (uint64)args->prev_pid;
  $next = (uint64)args->next_pid;
  $state = (uint64)args->prev_state;
  $at = nsecs(monotonic);
  $c = @cohort[$next];
  if ($c && @alive[$c] && @wait_out[$c]) {
    if ($at <= @wait_out[$c]) { @wait_invalid[$c] = @wait_invalid[$c] + 1; }
    else {
      @wait_count[$c] = @wait_count[$c] + 1;
      @wait_sum[$c] = @wait_sum[$c] + $at - @wait_out[$c];
      if ($at - @wait_out[$c] > @wait_max[$c]) {
        @wait_max[$c] = $at - @wait_out[$c];
        @wait_bounds[$c] = (@wait_out[$c], $at);
        @wait_max_stack[$c] = @wait_stack[$c];
      }
      if ($c == 1 && !@wait_fixture_printed) {
        @wait_fixture_printed = 1;
        printf("QFW_WAIT 1 %llu %llu %llu %llu\n%s\nQFW_STACK_END 1\n", @root[1], @birth[1], @wait_out[1], $at, @wait_stack[1]);
      }
    }
    delete(@wait_out[$c]); delete(@wait_stack[$c]);
  }
  $c = @cohort[$previous];
  if ($c && @alive[$c] && ($c == 2 || @wait_armed)) {
    if (tid != pid || @root[$c] != pid || @birth[$c] != (uint64)curtask->start_boottime || @parent[$c] != (uint64)curtask->real_parent->tgid || @parent_ticks[$c] != (uint64)curtask->real_parent->start_boottime / 10000000 || uid != $3) {
      @identity_lost[$c] = @identity_lost[$c] + 1;
    } else if ($state == (uint64)2) {
      if (@wait_out[$c]) { @wait_invalid[$c] = @wait_invalid[$c] + 1; }
      @wait_out[$c] = $at; @wait_stack[$c] = kstack(bpftrace, 32);
    }
  }
}

tracepoint:syscalls:sys_exit_setsid
/!@capture_closed && tid == pid && (uint64)args->ret == pid && uid == $3 && $6 == 100/
{
  $parent = (uint64)curtask->real_parent->tgid;
  $c = $parent == $2 ? 2 : 0;
  $ticks = (uint64)curtask->real_parent->start_boottime / 10000000;
  if ($c && $ticks == $5) {
    if (@root[$c]) { @extra_admission[$c] = @extra_admission[$c] + 1; }
    else {
      @root[$c] = pid; @birth[$c] = (uint64)curtask->start_boottime;
      @parent[$c] = $parent; @bound_ns[$c] = nsecs(monotonic); @alive[$c] = 1;
      @parent_ticks[$c] = $ticks;
      @cohort[pid] = $c;
      printf("QFW_BIND %llu %llu %llu %llu %llu %llu\n", $c, (uint64)pid, @birth[$c], $parent, (uint64)uid, @bound_ns[$c]);
    }
  }
}

tracepoint:filemap:mm_filemap_get_pages
/!@capture_closed && tid == pid && (@cohort[pid] || pid == $10)/
{
  $observed = nsecs(monotonic);
  if (pid == $10 && !@root[1] && uid == $3 && $6 == 100 && (uint64)curtask->start_boottime / 10000000 == $11 && (uint64)curtask->real_parent->tgid == $1 && (uint64)curtask->real_parent->start_boottime / 10000000 == $4) {
    @root[1] = pid; @birth[1] = (uint64)curtask->start_boottime;
    @parent[1] = $1; @parent_ticks[1] = $4; @bound_ns[1] = $observed;
    @alive[1] = 1; @cohort[pid] = 1;
    printf("QFW_BIND %llu %llu %llu %llu %llu %llu\n", (uint64)1, (uint64)pid, @birth[1], (uint64)$1, (uint64)uid, $observed);
  }
  $c = @cohort[pid]; $origin = (uint64)1;
  if ($c && @alive[$c] && @root[$c] == pid && @birth[$c] == (uint64)curtask->start_boottime && @parent[$c] == (uint64)curtask->real_parent->tgid && @parent_ticks[$c] == (uint64)curtask->real_parent->start_boottime / 10000000 && uid == $3) {
    $dev = (uint64)args->s_dev; $major = $dev >> 20; $minor = $dev & 1048575;
    $ino = (uint64)args->i_ino; $first = (uint64)args->index; $last = (uint64)args->last_index;
    @entries[$c, $origin] = @entries[$c, $origin] + 1;
    @last_file[$c, $origin] = ($major, $minor, $ino, $first, $last, $observed);
    if (!@seen[$c, $origin, $major, $minor, $ino] && @key_count[$c] >= 64) { @missing[$c] = @missing[$c] + 1; }
    else {
      if (!@seen[$c, $origin, $major, $minor, $ino]) { @seen[$c, $origin, $major, $minor, $ino] = 1; @key_count[$c] = @key_count[$c] + 1; }
      @count[$c, $origin, $major, $minor, $ino] = count();
    }
    $eligible = $c == 2 || ($major == $7 && $minor == $8 && $ino == $9);
    if ($eligible && @files_printed[$c, $origin] < (uint64)($c == 1 ? 2 : 8)) {
      @files_printed[$c, $origin] = @files_printed[$c, $origin] + 1;
      printf("QFW_FILE %llu %llu %llu %llu %llu %llu %llu %llu %llu %llu\n", $c, $origin, (uint64)pid, @birth[$c], $major, $minor, $ino, $first, $last, $observed);
    } else if ($eligible) { @files_omitted[$c, $origin] = @files_omitted[$c, $origin] + 1; }
  } else if ($c) { @identity_lost[$c] = @identity_lost[$c] + 1; }
}

tracepoint:filemap:mm_filemap_fault
/!@capture_closed && tid == pid && (@cohort[pid] || pid == $10)/
{
  $observed = nsecs(monotonic);
  if (pid == $10 && !@root[1] && uid == $3 && $6 == 100 && (uint64)curtask->start_boottime / 10000000 == $11 && (uint64)curtask->real_parent->tgid == $1 && (uint64)curtask->real_parent->start_boottime / 10000000 == $4) {
    @root[1] = pid; @birth[1] = (uint64)curtask->start_boottime;
    @parent[1] = $1; @parent_ticks[1] = $4; @bound_ns[1] = $observed;
    @alive[1] = 1; @cohort[pid] = 1;
    printf("QFW_BIND %llu %llu %llu %llu %llu %llu\n", (uint64)1, (uint64)pid, @birth[1], (uint64)$1, (uint64)uid, $observed);
  }
  $c = @cohort[pid]; $origin = (uint64)2;
  if ($c && @alive[$c] && @root[$c] == pid && @birth[$c] == (uint64)curtask->start_boottime && @parent[$c] == (uint64)curtask->real_parent->tgid && @parent_ticks[$c] == (uint64)curtask->real_parent->start_boottime / 10000000 && uid == $3) {
    $dev = (uint64)args->s_dev; $major = $dev >> 20; $minor = $dev & 1048575;
    $ino = (uint64)args->i_ino; $first = (uint64)args->index; $last = $first;
    @entries[$c, $origin] = @entries[$c, $origin] + 1;
    @last_file[$c, $origin] = ($major, $minor, $ino, $first, $last, $observed);
    if (!@seen[$c, $origin, $major, $minor, $ino] && @key_count[$c] >= 64) { @missing[$c] = @missing[$c] + 1; }
    else {
      if (!@seen[$c, $origin, $major, $minor, $ino]) { @seen[$c, $origin, $major, $minor, $ino] = 1; @key_count[$c] = @key_count[$c] + 1; }
      @count[$c, $origin, $major, $minor, $ino] = count();
    }
    $eligible = $c == 2 || ($major == $7 && $minor == $8 && $ino == $9);
    if ($eligible && @files_printed[$c, $origin] < (uint64)($c == 1 ? 2 : 8)) {
      @files_printed[$c, $origin] = @files_printed[$c, $origin] + 1;
      printf("QFW_FILE %llu %llu %llu %llu %llu %llu %llu %llu %llu %llu\n", $c, $origin, (uint64)pid, @birth[$c], $major, $minor, $ino, $first, $last, $observed);
    } else if ($eligible) { @files_omitted[$c, $origin] = @files_omitted[$c, $origin] + 1; }
  } else if ($c) { @identity_lost[$c] = @identity_lost[$c] + 1; }
}

tracepoint:sched:sched_process_exec
/!@capture_closed && tid == pid && @cohort[pid]/
{
  $c = @cohort[pid];
  if (@alive[$c] && @root[$c] == pid && @birth[$c] == (uint64)curtask->start_boottime && @parent[$c] == (uint64)curtask->real_parent->tgid && @parent_ticks[$c] == (uint64)curtask->real_parent->start_boottime / 10000000 && uid == $3) {
    @exec_ns[$c] = nsecs(monotonic); @exec_birth[$c] = (uint64)curtask->start_boottime;
    $mm = curtask->mm;
    if ($mm != 0 && $mm->exe_file != 0 && $mm->exe_file->f_inode != 0) { @exec_inode[$c] = (uint64)$mm->exe_file->f_inode->i_ino; }
    else { @exec_inode[$c] = 0; @exec_missing[$c] = @exec_missing[$c] + 1; }
    @exec_count[$c] = @exec_count[$c] + 1;
  }
}

tracepoint:signal:signal_generate
/!@capture_closed && args->sig == 15 && @cohort[(uint64)args->pid]/
{
  $c = @cohort[(uint64)args->pid];
  $at = nsecs(monotonic);
  if (@alive[$c] && @root[$c] == (uint64)args->pid && !@first_term_ns[$c]) {
    @first_term_ns[$c] = $at;
    @term_sender[$c] = ((uint64)pid, (uint64)curtask->group_leader->start_boottime, (uint64)uid, (int32)args->result);
    printf("QFW_TERM %llu %llu %llu %llu %llu %llu %llu %lld\n", $c, @root[$c], @birth[$c], @first_term_ns[$c], (uint64)pid, (uint64)curtask->group_leader->start_boottime, (uint64)uid, (int32)args->result);
  }
}

tracepoint:sched:sched_process_exit
/!@capture_closed && tid == pid && @cohort[pid]/
{
  $c = @cohort[pid];
  if (@root[$c] == pid && @birth[$c] == (uint64)curtask->start_boottime) {
    @alive[$c] = 0; @exit_ns[$c] = nsecs(monotonic);
    printf("QFW_EXIT %llu %llu %llu %llu\n", $c, (uint64)pid, @birth[$c], @exit_ns[$c]);
  }
}

interval:s:1 {
  if (!@capture_closed) {
    printf("QFW_TICK %llu\n", nsecs(monotonic));
    if (@root[2] && nsecs(monotonic) - @bound_ns[2] >= 21000000000) {
      @capture_closed = 1; @window_closed_ns = nsecs(monotonic);
      exit();
    }
  }
}
END {
  if (@wait_max[2]) {
    printf("QFW_WAIT 2 %llu %llu %llu %llu\n%s\nQFW_STACK_END 2\n", @root[2], @birth[2], @wait_bounds[2].0, @wait_bounds[2].1, @wait_max_stack[2]);
  }
  /* An unpaired switch-out is censored, never a completed wait duration. */
  if (@wait_out[2] && @window_closed_ns) {
    $censor = @window_closed_ns;
    if (@first_term_ns[2] && @first_term_ns[2] < $censor) { $censor = @first_term_ns[2]; }
    if (@exit_ns[2] && @exit_ns[2] < $censor) { $censor = @exit_ns[2]; }
    if (@wait_out[2] < $censor) {
      printf("QFW_PENDING 2 %llu %llu %llu %llu\n%s\nQFW_STACK_END 2\n", @root[2], @birth[2], @wait_out[2], $censor, @wait_stack[2]);
    }
  }
  delete(@wait_stack[1]); delete(@wait_stack[2]);
  delete(@wait_max_stack[1]); delete(@wait_max_stack[2]);
  /* Detach and END precede the join phase. Retain the actual capture cutoff. */
  if (@window_closed_ns) { printf("QFW_WINDOW_CLOSED %llu\n", @window_closed_ns); }
  printf("QFW_END %llu\n", nsecs(monotonic));
} /* Remaining automatic maps contain numeric keys/values only. */
