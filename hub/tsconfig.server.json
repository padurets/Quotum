{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "dist/server",
    "rootDir": "server",
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "server/**/*.ts"
  ],
  "exclude": [
    "server/test/**/*.ts"
  ]
}
