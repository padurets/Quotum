{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["ui/**/*.tsx", "ui/**/*.ts", "vite.config.ts", "vite.bundle.config.ts"],
  "exclude": ["ui/test/**/*.ts"]
}
